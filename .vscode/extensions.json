{
  // Extensões recomendadas para quem está começando
  // O VS Code pergunta se quer instalar quando você abre o projeto
  "recommendations": [
    // 🇧🇷 Traduz o VS Code para português
    "MS-CEINTL.vscode-language-pack-pt-BR",

    // ✨ Formata o código automaticamente (deixa tudo alinhado)
    "esbenp.prettier-vscode",

    // 🌐 Cria um servidor local para ver seu site atualizando em tempo real
    "ritwickdey.LiveServer",

    // 🏷️ Renomeia tags HTML junto (muda <div> e o </div> muda junto)
    "formulahendry.auto-rename-tag",

    // 📁 Autocompleta caminhos de arquivo (ajuda a não errar nome de pasta)
    "christian-kohler.path-intellisense",

    // ⚠️ Mostra erros direto no código (não precisa ficar procurando)
    "usernamehw.errorlens",

    // 🎨 Mostra cores no código (vê que cor é #ff5733 sem abrir nada)
    "naumovs.color-highlight",

    // 🔧 Configura nome e email do Git automaticamente em cada projeto
    "shyykoserhiy.git-autoconfig"
  ]
}
